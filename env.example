# =============================================================================
# AtlasTrips — Environment Variable Checklist
# Copy this file to ".env" and fill in real values. Never commit the real ".env".
# =============================================================================

# -----------------------------------------------------------------------------
# MONGODB_ATLAS_URI (REQUIRED)
# Full SRV connection string for your MongoDB Atlas cluster, including
# credentials and any connection options. Found in Atlas UI -> Connect ->
# "Drivers" -> copy the connection string and swap in your DB user password.
#
# Format:
#   mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=AtlasTrips
#
# Notes:
#   - The DB user needs readWrite on the target database (atlastrips) plus
#     the built-in "Search Index Editor" role if you want app.py / seed.py
#     to manage Atlas Search indexes programmatically.
#   - Make sure your current IP (or 0.0.0.0/0 for a throwaway demo cluster)
#     is allow-listed under Atlas Network Access.
# -----------------------------------------------------------------------------
MONGODB_ATLAS_URI=mongodb+srv://demo_user:CHANGE_ME@atlastrips-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=AtlasTrips

# -----------------------------------------------------------------------------
# DB_NAME (REQUIRED, defaults to "atlastrips")
# Logical database that holds the venues/users collections for this demo.
# -----------------------------------------------------------------------------
DB_NAME=atlastrips

# -----------------------------------------------------------------------------
# COLLECTION_NAME (REQUIRED, defaults to "venues")
# Primary denormalized collection (hotels, lounges, events) that powers both
# the Atlas Search autocomplete and the single-document "Book Now" reads.
# -----------------------------------------------------------------------------
COLLECTION_NAME=venues

# -----------------------------------------------------------------------------
# USERS_COLLECTION_NAME (optional, defaults to "users")
# Secondary collection used for the booking/user-profile flow in the demo UI.
# -----------------------------------------------------------------------------
USERS_COLLECTION_NAME=users

# -----------------------------------------------------------------------------
# SEARCH_INDEX_NAME (optional, defaults to "venues_autocomplete")
# Name of the Atlas Search index created from search/atlas_search_index.json.
# Must match the index name referenced inside the $search aggregation stages
# in app.py / db/connection.py.
# -----------------------------------------------------------------------------
SEARCH_INDEX_NAME=venues_autocomplete

# -----------------------------------------------------------------------------
# METRICS_COLLECTION_NAME (optional, defaults to "metrics_events")
# Where app.py and locustfile.py both write per-request latency/outcome
# samples. This is what powers the "Live Metrics Scorecard" in the Behind
# the Scenes tab -- the load generator's own telemetry lands in the same
# Atlas cluster as the app data, instead of a separate metrics stack.
# -----------------------------------------------------------------------------
METRICS_COLLECTION_NAME=metrics_events

# -----------------------------------------------------------------------------
# SEED_DOCUMENT_COUNT (optional, defaults to 2000)
# How many venue documents db/seed.py should generate on a fresh run.
# Higher counts (10k-100k) make the Locust load test and the "Reliability at
# Peak" demo tab more convincing.
# -----------------------------------------------------------------------------
SEED_DOCUMENT_COUNT=2000

# -----------------------------------------------------------------------------
# LOCUST_TARGET_HOST (optional, defaults to http://localhost:8501)
# Base host Locust attacks. For this demo, Locust talks directly to the same
# Atlas cluster via PyMongo (not HTTP), so this is mainly informational /
# used if you front the data layer with a small FastAPI shim instead.
# -----------------------------------------------------------------------------
LOCUST_TARGET_HOST=http://localhost:8501
